// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

model User {
  userId       String     @id @default(cuid()) @map("user_id")
  firstName    String     @map("first_name") @db.VarChar(30)
  lastName     String     @map("last_name") @db.VarChar(30)
  email        String     @unique @map("email") @db.VarChar(100)
  password     String     @map("password") @db.VarChar(255)
  refreshToken String?    @unique @map("refresh_token") @db.VarChar(255)
  status       UserStatus @default(ACTIVE) @map("status")
  role         Role       @default(EMPLOYEE) @map("role")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([role], name: "idx_role") // For role-based filtering
  @@map("users")
}

model Customer {
  customerId  String     @id @default(cuid()) @map("customer_id")
  name        String     @map("name") @db.VarChar(100)
  email       String     @unique @map("email") @db.VarChar(100)
  phoneNo     String     @unique @map("phone_no") @db.VarChar(10)
  aadhaarNo   String     @unique @map("aadhaar_no") @db.VarChar(12)
  panNo       String     @unique @map("pan_no") @db.VarChar(10)
  dateOfBirth DateTime   @map("date_of_birth")
  pinCode     String     @map("pin_code") @db.VarChar(6)
  address     String     @map("address") @db.Text
  branchName  String     @map("branch_name") @db.VarChar(100)
  status      UserStatus @default(ACTIVE) @map("status")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  accounts    Accounts[]

  @@index([dateOfBirth], name: "idx_date_of_birth") // For age-based queries
  @@index([branchName], name: "idx_branch_name") // For branch-based filtering
  @@map("customers")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
  FREEZE
}

enum AccountType {
  SAVINGS
  CHECKING
  CREDIT
  LOAN
}

model Accounts {
  accountId     String        @id @default(cuid()) @map("account_id")
  accountNumber String        @unique @map("account_number") @db.VarChar(20)
  customerId    String        @map("customer_id")
  Customer      Customer      @relation(fields: [customerId], references: [customerId], onDelete: Cascade, onUpdate: Cascade)
  accountType   AccountType   @map("account_type")
  status        AccountStatus @default(ACTIVE) @map("status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactionEntries Transaction_Entry[]

  @@index([customerId], name: "idx_customer_id")
  @@index([accountType], name: "idx_account_type")
  @@index([status], name: "idx_status")
  @@map("accounts")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model Transaction {
  transactionId         String            @id @default(cuid()) @map("transaction_id")
  transaction_reference String            @unique @map("transaction_reference") @db.VarChar(100)
  amount                Decimal           @map("amount") @db.Decimal(19, 4)
  transactionType       TransactionType   @map("transaction_type")
  transactionStatus     TransactionStatus @map("transaction_status")
  description           String?           @map("description") @db.VarChar(255)

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  transactionEntries Transaction_Entry[]

  @@index([transactionType], name: "idx_transaction_type")
  @@index([transactionStatus], name: "idx_transaction_status")
  @@map("transactions")
}

enum TransactionEntryType {
  DEBIT
  CREDIT
}

model Transaction_Entry {
  transactionEntryId String               @id @default(cuid()) @map("transaction_entry_id")
  transactionId      String               @map("transaction_id")
  Transaction        Transaction          @relation(fields: [transactionId], references: [transactionId], onDelete: Cascade, onUpdate: Cascade)
  accountId          String               @map("account_id")
  Accounts           Accounts             @relation(fields: [accountId], references: [accountId], onDelete: Cascade, onUpdate: Cascade)
  entryType          TransactionEntryType @map("entry_type")
  ammount            Decimal              @map("amount") @db.Decimal(19, 4)
  createdAt          DateTime             @default(now()) @map("created_at")

  @@index([entryType], name: "idx_entry_type")
  @@index([transactionId], name: "idx_transaction_id")
  @@index([accountId], name: "idx_account_id")
  @@map("transaction_entries")
}
